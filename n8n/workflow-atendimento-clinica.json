{
  "name": "Atendimento IA - WhatsApp Clinica (Template Portfolio)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook-clinica",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a1e1111-0001-4a00-9a00-000000000001",
      "name": "Webhook WhatsApp (Meta Cloud API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1180, 300],
      "webhookId": "whatsapp-webhook-clinica"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload recebido da WhatsApp Cloud API\nconst body = $input.first().json.body;\nconst entry = body.entry?.[0]?.changes?.[0]?.value;\nconst message = entry?.messages?.[0];\n\nreturn [{\n  json: {\n    from: message?.from || null,\n    text: message?.text?.body || '',\n    messageId: message?.id || null,\n    timestamp: message?.timestamp || null,\n    contactName: entry?.contacts?.[0]?.profile?.name || 'Paciente'\n  }\n}];\n"
      },
      "id": "1a1e1111-0002-4a00-9a00-000000000002",
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 300]
    },
    {
      "parameters": {
        "jsCode": "// GUARDRAIL DE ENTRADA\n// Detecta gatilhos que exigem escalonamento humano IMEDIATO,\n// antes mesmo de chamar a IA (sintomas, urgencia, pedido de humano).\nconst text = ($json.text || '').toLowerCase();\n\nconst gatilhosUrgencia = ['dor forte', 'emergencia', 'urgente', 'sangramento', 'desmaio', 'nao consigo respirar', 'piorou'];\nconst gatilhosHumano = ['falar com atendente', 'quero um humano', 'falar com pessoa', 'reclamacao', 'reclamar'];\n\nconst precisaEscalonar = gatilhosUrgencia.some(g => text.includes(g)) || gatilhosHumano.some(g => text.includes(g));\n\nreturn [{ json: { ...$json, escalonamento_forcado: precisaEscalonar } }];\n"
      },
      "id": "1a1e1111-0003-4a00-9a00-000000000003",
      "name": "Guardrail de Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.escalonamento_forcado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1e1111-0004-4a00-9a00-000000000004",
      "name": "Precisa Escalonar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-520, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "Voce e o assistente virtual da clinica. Siga ESTRITAMENTE as regras em /docs/regras-ia-atendimento.md: responda apenas sobre horarios, endereco, convenios, valores pre-cadastrados e agendamento. NUNCA de diagnostico, opiniao clinica ou recomende medicamentos. Se nao tiver certeza, ou o assunto sair do escopo administrativo, responda pedindo para transferir a um atendente humano. Tom cordial, claro e objetivo."
        }
      },
      "id": "1a1e1111-0005-4a00-9a00-000000000005",
      "name": "Agente de IA (LLM)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-300, 220]
    },
    {
      "parameters": {
        "jsCode": "// GUARDRAIL DE SAIDA\n// Bloqueia qualquer resposta da IA que contenha termos de diagnostico,\n// medicamentos ou aconselhamento clinico antes de enviar ao paciente.\nconst resposta = ($json.output || '').toLowerCase();\n\nconst termosProibidos = ['diagnostico', 'tome ', 'mg de', 'dosagem', 'recomendo o remedio', 'voce esta com'];\nconst bloqueado = termosProibidos.some(t => resposta.includes(t));\n\nreturn [{\n  json: {\n    ...$json,\n    resposta_final: bloqueado\n      ? 'Vou te transferir para nossa equipe para te ajudar com isso da melhor forma.'\n      : $json.output,\n    bloqueado_pelo_guardrail: bloqueado\n  }\n}];\n"
      },
      "id": "1a1e1111-0006-4a00-9a00-000000000006",
      "name": "Guardrail de Saida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 220]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": "clinica@example.com",
        "options": {}
      },
      "id": "1a1e1111-0007-4a00-9a00-000000000007",
      "name": "Consultar Agenda (Google Calendar)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [-300, 420]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "SEU_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.from }}",
        "textBody": "={{ $json.resposta_final }}"
      },
      "id": "1a1e1111-0008-4a00-9a00-000000000008",
      "name": "Enviar Resposta (WhatsApp Cloud API)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [140, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "SEU_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.from }}",
        "textBody": "Entendi. Vou te transferir para um de nossos atendentes, que continua a conversa por aqui em instantes."
      },
      "id": "1a1e1111-0009-4a00-9a00-000000000009",
      "name": "Avisar Escalonamento ao Paciente",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [-300, 380]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": "equipe-clinica",
        "text": "=Novo atendimento escalonado para humano.\\nPaciente: {{ $json.contactName }}\\nTelefone: {{ $json.from }}\\nMensagem: {{ $json.text }}"
      },
      "id": "1a1e1111-0010-4a00-9a00-000000000010",
      "name": "Notificar Equipe (Slack/Interno)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [-80, 380]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "PLANILHA_DE_AUDITORIA_ID",
        "sheetName": "Conversas",
        "columns": {
          "value": {
            "data_hora": "={{ $now }}",
            "telefone": "={{ $json.from }}",
            "mensagem_recebida": "={{ $json.text }}",
            "resposta_enviada": "={{ $json.resposta_final || 'Escalonado para humano' }}",
            "escalonado": "={{ $json.escalonamento_forcado || $json.bloqueado_pelo_guardrail || false }}"
          }
        }
      },
      "id": "1a1e1111-0011-4a00-9a00-000000000011",
      "name": "Registrar Auditoria (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [380, 300]
    }
  ],
  "connections": {
    "Webhook WhatsApp (Meta Cloud API)": {
      "main": [[{ "node": "Normalizar Payload", "type": "main", "index": 0 }]]
    },
    "Normalizar Payload": {
      "main": [[{ "node": "Guardrail de Entrada", "type": "main", "index": 0 }]]
    },
    "Guardrail de Entrada": {
