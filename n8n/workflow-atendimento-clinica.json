    },
    "Precisa Escalonar?": {
      "main": [
        [
          { "node": "Avisar Escalonamento ao Paciente", "type": "main", "index": 0 },
          { "node": "Notificar Equipe (Slack/Interno)", "type": "main", "index": 0 }
        ],
        [{ "node": "Agente de IA (LLM)", "type": "main", "index": 0 }]
      ]
    },
    "Agente de IA (LLM)": {
      "main": [[{ "node": "Guardrail de Saida", "type": "main", "index": 0 }]]
    },
    "Guardrail de Saida": {
      "main": [[{ "node": "Enviar Resposta (WhatsApp Cloud API)", "type": "main", "index": 0 }]]
    },
    "Enviar Resposta (WhatsApp Cloud API)": {
      "main": [[{ "node": "Registrar Auditoria (Google Sheets)", "type": "main", "index": 0 }]]
    },
    "Avisar Escalonamento ao Paciente": {
      "main": [[{ "node": "Registrar Auditoria (Google Sheets)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
